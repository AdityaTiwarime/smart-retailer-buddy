# Postgres connection string (Neon). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Any long random string. Keeps shoppers logged in across restarts.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: GPT parses requests when set; otherwise the built-in TensorFlow model does.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_CALLS_PER_HOUR=60      # per-user limit that protects your key
